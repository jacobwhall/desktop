# Fedora-based Coder envbox inner image.
#
# The "inner" image is what a Coder workspace runs as inside envbox; the outer
# envbox image (ghcr.io/coder/envbox) provides sysbox and is untouched. This
# image must be Coder-workspace-ready:
#   - a workspace user (uid 1000) with a home under /home and passwordless sudo.
#     The name is a contract with the template: it must set
#     CODER_INNER_USERNAME and mount the home volume to match, because envbox
#     looks the user up and chowns that home. This image uses 'jacob' rather
#     than the conventional 'coder' — see the inner_username parameter in
#     nova-fluxcd's workspace-template-envbox,
#   - bootstrap tooling the agent + code-server need,
#   - docker-ce with runc pinned to 1.2.x (sysbox 0.6.7, bundled in envbox, is
#     incompatible with runc >= 1.3.3 — see the nova-fluxcd envbox template README).
#
# Beyond that it carries the command-line half of the desktop images in this
# repo (recipes/recipe.yml, recipes/sway.yml): the same shell, editor and
# Homebrew setup, minus everything that only makes sense on a real desktop
# (Sway/GTK/portals, Mullvad, Slack, Handy, ydotool) or under a real kernel.

ARG FEDORA_VERSION=44
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

# Bootstrap tooling for the Coder agent + code-server, plus dev niceties.
RUN dnf -y install \
      bash curl ca-certificates sudo tar gzip git tmux\
      procps-ng iproute hostname which findutils \
      btop fish vim-enhanced vim-default-editor file \
      bind-utils iputils ripgrep jq yq tmux rsync unzip \
      gcc gcc-c++ make pkgconf \
 && dnf clean all

# The workspace user (uid 1000) with passwordless sudo. uid 1000 is fixed —
# envbox and the home volume both assume it — but the name is a build arg so a
# rebuild can produce an image for a differently-named template.
ARG USERNAME=jacob
RUN useradd -u 1000 -m -s /usr/bin/fish "${USERNAME}" \
 && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
 && chmod 0440 "/etc/sudoers.d/${USERNAME}"

# Docker CE from docker.com (uses runc, unlike Fedora's default moby/crun). The
# .repo file is fetched directly so this works across dnf4/dnf5.
RUN curl -fsSL https://download.docker.com/linux/fedora/docker-ce.repo \
      -o /etc/yum.repos.d/docker-ce.repo \
 && dnf -y install docker-ce docker-ce-cli containerd.io \
      docker-buildx-plugin docker-compose-plugin \
 && dnf clean all \
 && usermod -aG docker "${USERNAME}"

# Force the nftables iptables backend. docker-ce's RPM only Requires: iptables,
# which Fedora satisfies with iptables-legacy — and legacy needs the 'ip_tables'
# kernel module, which an unprivileged container under sysbox cannot modprobe.
# dockerd then dies at startup with:
#   failed to register "bridge" driver: failed to create NAT chain DOCKER:
#   modprobe: ERROR: could not insert 'ip_tables': Operation not permitted
#   iptables v1.8.11 (legacy): can't initialize iptables table `nat'
# The nft backend needs no such module and works inside sysbox.
RUN dnf -y install iptables-nft \
 && dnf clean all \
 && alternatives --set iptables /usr/sbin/iptables-nft \
 && iptables --version | grep -q nf_tables

# Pin runc to 1.2.x — sysbox 0.6.7 breaks with runc >= 1.3.3. Overwrite the
# containerd.io-provided binary; a built image doesn't dnf-upgrade at runtime,
# so this sticks. Bump only once envbox ships a sysbox that supports runc 1.3.x.
ARG RUNC_VERSION=v1.2.6
RUN curl -fsSL -o /usr/bin/runc \
      "https://github.com/opencontainers/runc/releases/download/${RUNC_VERSION}/runc.amd64" \
 && chmod 0755 /usr/bin/runc \
 && runc --version

# The desktop recipes' brew module sets nofile-limits: true. There is no systemd
# here to raise DefaultLimitNOFILE, so this covers the PAM half only — it applies
# to login sessions (ssh, su), not to processes the Coder agent spawns directly,
# whose limits come from the container runtime.
RUN printf '%s\n' \
      '* soft nofile 65536' \
      '* hard nofile 65536' \
      > /etc/security/limits.d/50-nofile.conf

# Pre-create the Homebrew prefix, owned by the workspace user. The installer
# below runs unprivileged and would otherwise reach for sudo to create
# /home/linuxbrew — and sudo does not work inside the buildx sandbox on the CI
# runner, even though this user has passwordless sudo at runtime, so the build
# aborted with "Insufficient permissions to install Homebrew to
# /home/linuxbrew/.linuxbrew (the default prefix)". install.sh skips the sudo
# check entirely when the prefix is already writable, and falls back to running
# its commands directly wherever it would have used sudo.
RUN mkdir -p /home/linuxbrew/.linuxbrew \
 && chown -R "${USERNAME}:${USERNAME}" /home/linuxbrew

USER ${USERNAME}

# Homebrew, matching the desktop recipes' brew module. Installed as the
# workspace user because the installer refuses to run as root; it lands in
# /home/linuxbrew, deliberately outside that user's home, so it survives envbox
# mounting a volume over the workspace home. HOMEBREW_NO_ANALYTICS is the ENV
# equivalent of the module's brew-analytics: false, and applies at runtime as
# well as during build.
ENV HOMEBREW_NO_ANALYTICS=1
RUN NONINTERACTIVE=1 /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
 && /home/linuxbrew/.linuxbrew/bin/brew --version

# Put brew (and the user's own bin) on PATH for the rest of the build, and at
# runtime — ENV also covers non-interactive shells, which a shell rc edit would
# not.
ENV PATH=/home/${USERNAME}/.local/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:$PATH

# Claude Code, kubectl and Tilt, all via brew so they land under /home/linuxbrew.
#
# Claude Code was previously installed with Anthropic's own installer
# (claude.ai/install.sh), but that is a per-user install into
# $HOME/.local/bin — which envbox mounts the workspace home volume straight
# over, so the binary was gone by the time a workspace started and 'claude' was
# not a recognized command. The brew cask installs to the Caskroom with a
# symlink at /home/linuxbrew/.linuxbrew/bin/claude, outside the home, for the
# same reason brew itself lives there. It is a cask rather than a formula even
# on Linux; recent Homebrew supports Linux casks and this one ships
# x86_64_linux/arm64_linux variations.
#
# 'kubectl' is an alias for the kubernetes-cli formula. Tilt is brew rather than
# tilt.dev's install.sh because that script installs to /usr/local/bin via sudo,
# which does not work in the buildx sandbox on the CI runner (see the Homebrew
# prefix note above).
RUN brew install --cask claude-code \
 && brew install kubectl tilt \
 && brew cleanup --prune=all \
 && claude --version \
 && kubectl version --client \
 && tilt version
